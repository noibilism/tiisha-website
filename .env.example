# Where the product app lives. Sign in, sign up and tutor apply links point here.
NEXT_PUBLIC_APP_URL=https://app.tiisha.com
# Public origin of this marketing site. Used for canonicals, sitemap, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=https://tiisha.com
# Optional. "G-XXXX" loads GA4. Any other value is used as a Plausible domain. Unset disables analytics.
NEXT_PUBLIC_ANALYTICS_ID=
# Optional. Store listings for the iPhone, iPad and Android apps. Leave empty until the apps are live: the site then shows
# a disabled "Coming soon" button instead of a link. Must start with https://.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
